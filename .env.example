# =============================================================================
# Audio Tutor - environment configuration
# Copy this file to `.env` and fill in the values before running
# `docker compose up`.
# =============================================================================

# --- Anthropic (Claude) ---------------------------------------------------
# Required for ALL agent functionality (research, tutoring, evaluation).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model routing. Override if you want to pin exact snapshots; defaults below
# pick the latest aliases available at build time. See README section
# "Model routing" for why each agent uses the tier it uses.
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5
ANTHROPIC_MODEL_OPUS=claude-opus-4-1

# --- Web research ----------------------------------------------------------
# Anthropic's server-side web_search / web_fetch tools are used by default
# (no extra key needed beyond ANTHROPIC_API_KEY). If those tools are not
# enabled/available for your account or environment, set SEARCH_PROVIDER=tavily
# and provide a Tavily key (https://tavily.com) as a fallback.
SEARCH_PROVIDER=anthropic
TAVILY_API_KEY=

# --- Speech-to-text (Deepgram) ---------------------------------------------
# Required for live voice sessions (browser mic -> streaming transcription).
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- Text-to-speech (ElevenLabs) --------------------------------------------
# Required for live voice sessions (tutor speech synthesis).
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Supabase (Postgres + Auth + Storage) -----------------------------------
# In production, create a project at https://supabase.com and fill these in.
# For local development, leave SUPABASE_URL empty: the backend falls back to
# the local Postgres container defined in docker-compose.yml and a dev-mode
# auth bypass (see README "Local development without Supabase").
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (used directly by the backend via SQLAlchemy) ----------------
# Default matches the local `postgres` service in docker-compose.yml.
# If SUPABASE_URL is set, point this at the Supabase Postgres connection
# string instead (Project Settings -> Database -> Connection string).
DATABASE_URL=postgresql+asyncpg://audiotutor:audiotutor@postgres:5432/audiotutor

# --- Redis (cache + arq task queue) -----------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Observability -----------------------------------------------------------
# Optional. Leave empty to disable.
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# --- App config --------------------------------------------------------------
ENV=development
# When true, API auth accepts a dev bypass (X-Dev-User-Id header) instead of
# requiring a real Supabase JWT. NEVER set true in production.
DEV_AUTH_BYPASS=true
DEFAULT_LOCALE=pl
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js, exposed to the browser) ------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
